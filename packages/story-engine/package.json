{
  "name": "@offscreen/story-engine",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./stories": {
      "types": "./dist/stories/index.d.ts",
      "default": "./dist/stories/index.js"
    },
    "./stories/*": {
      "types": "./dist/stories/*.d.ts",
      "default": "./dist/stories/*.js"
    },
    "./campaign": {
      "types": "./dist/campaign/index.d.ts",
      "default": "./dist/campaign/index.js"
    },
    "./campaign/*": {
      "types": "./dist/campaign/*.d.ts",
      "default": "./dist/campaign/*.js"
    },
    "./storyteller": {
      "types": "./dist/storyteller/index.d.ts",
      "default": "./dist/storyteller/index.js"
    },
    "./storyteller/*": {
      "types": "./dist/storyteller/*.d.ts",
      "default": "./dist/storyteller/*.js"
    },
    "./generations": {
      "types": "./dist/generations/index.d.ts",
      "default": "./dist/generations/index.js"
    },
    "./generations/*": {
      "types": "./dist/generations/*.d.ts",
      "default": "./dist/generations/*.js"
    },
    "./drafts": {
      "types": "./dist/drafts/index.d.ts",
      "default": "./dist/drafts/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@offscreen/cache-port": "workspace:*",
    "@offscreen/usage-policy": "workspace:*",
    "@offscreen/db": "workspace:*",
    "@offscreen/documents": "workspace:*",
    "@offscreen/game": "workspace:*",
    "@offscreen/storyteller": "workspace:*",
    "drizzle-orm": "0.45.2",
    "zod": "4.6.5",
    "@offscreen/story-interface": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@offscreen/config": "workspace:*",
    "typescript": "5.9.3"
  }
}
