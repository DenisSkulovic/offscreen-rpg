{
  "name": "@offscreen/lab-support",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./lab/*": {
      "types": "./dist/lab/*.d.ts",
      "default": "./dist/lab/*.js"
    },
    "./qa-catalog/*": {
      "types": "./dist/qa-catalog/*.d.ts",
      "default": "./dist/qa-catalog/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@offscreen/contracts": "workspace:*",
    "@offscreen/usage-policy": "workspace:*",
    "@offscreen/db": "workspace:*",
    "@offscreen/documents": "workspace:*",
    "@offscreen/game": "workspace:*",
    "@offscreen/story-engine": "workspace:*",
    "@offscreen/storyteller": "workspace:*",
    "drizzle-orm": "0.45.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@offscreen/config": "workspace:*",
    "typescript": "5.9.3"
  }
}