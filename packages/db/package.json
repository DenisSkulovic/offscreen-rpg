{
  "name": "@offscreen/db",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./migrate": {
      "types": "./dist/src/migrate.d.ts",
      "default": "./dist/src/migrate.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/test/config.test.js",
    "test:integration": "node --test dist/test/database.integration.js"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@offscreen/config": "workspace:*",
    "@types/node": "22.20.3",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
