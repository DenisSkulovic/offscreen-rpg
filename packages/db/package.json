{
  "name": "@offscreen/db",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./generation-schema": {
      "types": "./dist/src/schema/generations.d.ts",
      "default": "./dist/src/schema/generations.js"
    },
    "./draft-schema": {
      "types": "./dist/src/schema/drafts.d.ts",
      "default": "./dist/src/schema/drafts.js"
    },
    "./schema": {
      "types": "./dist/src/schema/auth.d.ts",
      "default": "./dist/src/schema/auth.js"
    },
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./migrate": {
      "types": "./dist/src/migrate.d.ts",
      "default": "./dist/src/migrate.js"
    },
    "./outbox-schema": {
      "types": "./dist/src/schema/outbox.d.ts",
      "default": "./dist/src/schema/outbox.js"
    },
    "./outbox": {
      "types": "./dist/src/outbox.d.ts",
      "default": "./dist/src/outbox.js"
    },
    "./outbox-relay": {
      "types": "./dist/src/outbox-relay.d.ts",
      "default": "./dist/src/outbox-relay.js"
    },
    "./story-schema": {
      "types": "./dist/src/schema/stories.d.ts",
      "default": "./dist/src/schema/stories.js"
    },
    "./launch-schema": {
      "types": "./dist/src/schema/launch.d.ts",
      "default": "./dist/src/schema/launch.js"
    },
    "./storyteller-schema": {
      "types": "./dist/src/schema/storyteller.d.ts",
      "default": "./dist/src/schema/storyteller.js"
    },
    "./campaign-schema": {
      "types": "./dist/src/schema/campaign.d.ts",
      "default": "./dist/src/schema/campaign.js"
    },
    "./qa-schema": {
      "types": "./dist/src/schema/qa.d.ts",
      "default": "./dist/src/schema/qa.js"
    },
    "./admin-schema": {
      "types": "./dist/src/schema/admin.d.ts",
      "default": "./dist/src/schema/admin.js"
    },
    "./terminal-auth-schema": {
      "types": "./dist/src/schema/terminal-auth.d.ts",
      "default": "./dist/src/schema/terminal-auth.js"
    },
    "./terminal-auth-store": {
      "types": "./dist/src/terminal-auth-store.d.ts",
      "default": "./dist/src/terminal-auth-store.js"
    }
  },
  "scripts": {
    "migrate": "node --env-file-if-exists=../../.env dist/src/migrate-cli.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/test/config.test.js dist/test/db06-admission.test.js dist/test/db06-pool.test.js dist/test/db08-journal.test.js dist/test/db08-runner.test.js",
    "test:integration": "node --test dist/test/database.integration.js"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@offscreen/config": "workspace:*",
    "@types/node": "22.20.3",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
