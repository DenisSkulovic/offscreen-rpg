{
  "name": "@offscreen/db",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./generation-schema": {
      "types": "./dist/src/schema/generations.d.ts",
      "default": "./dist/src/schema/generations.js"
    },
    "./draft-schema": {
      "types": "./dist/src/schema/drafts.d.ts",
      "default": "./dist/src/schema/drafts.js"
    },
    "./schema": {
      "types": "./dist/src/schema/auth.d.ts",
      "default": "./dist/src/schema/auth.js"
    },
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./migrate": {
      "types": "./dist/src/migrate.d.ts",
      "default": "./dist/src/migrate.js"
    },
    "./outbox-schema": {
      "types": "./dist/src/schema/outbox.d.ts",
      "default": "./dist/src/schema/outbox.js"
    },
    "./story-schema": {
      "types": "./dist/src/schema/stories.d.ts",
      "default": "./dist/src/schema/stories.js"
    }
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "node --env-file-if-exists=../../.env dist/src/migrate-cli.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/test/config.test.js",
    "test:integration": "node --test dist/test/database.integration.js"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@offscreen/config": "workspace:*",
    "@types/node": "22.20.3",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3"
  }
}
