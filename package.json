{
  "name": "offscreen-rpg",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:db": "pnpm --filter @offscreen/db build && pnpm --filter @offscreen/db test:integration",
    "test:auth": "turbo run build --filter=@offscreen/api-integration && pnpm --filter @offscreen/api-integration test:integration",
    "test:stories": "turbo run build --filter=@offscreen/api-integration && pnpm --filter @offscreen/api-integration test:stories",
    "test:focus": "node scripts/repo-tools/focused-integration.mjs",
    "db:migrate": "pnpm --filter @offscreen/db build && pnpm --filter @offscreen/db migrate",
    "db:baseline": "node scripts/repo-tools/baseline.mjs",
    "db:reset:test": "node scripts/repo-tools/reset-test-db.mjs",
    "repo:brief": "node scripts/repo-tools/brief.mjs",
    "infra": "node scripts/repo-tools/compose.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "node scripts/repo-tools/compose.mjs up -d --wait",
    "infra:down": "node scripts/repo-tools/compose.mjs down",
    "infra:repair": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/repo-tools/repair-docker-desktop.ps1",
    "chamber": "turbo run build --filter=@offscreen/chamber && pnpm --filter @offscreen/chamber start",
    "story:local": "turbo run build --filter=@offscreen/chamber && pnpm --filter @offscreen/chamber start --story-mode",
    "story:inspect": "node scripts/repo-tools/story-session-report.mjs",
    "chamber:reset": "turbo run build --filter=@offscreen/chamber && pnpm --filter @offscreen/chamber start --reset-database",
    "chamber:packet": "turbo run build --filter=@offscreen/chamber && pnpm --filter @offscreen/chamber start --packet-review",
    "chamber:memory-packet": "turbo run build --filter=@offscreen/chamber && pnpm --filter @offscreen/chamber start --memory-packet-review",
    "chamber:memory-evaluation-packet": "turbo run build --filter=@offscreen/chamber && pnpm --filter @offscreen/chamber start --memory-evaluation-packet",
    "chamber:memory-evaluation-run": "turbo run build --filter=@offscreen/chamber && pnpm --filter @offscreen/chamber start --memory-evaluation-run",
    "chamber:evaluation-packet": "turbo run build --filter=@offscreen/chamber && pnpm --filter @offscreen/chamber start --evaluation-packet",
    "chamber:evaluation-run": "turbo run build --filter=@offscreen/chamber && pnpm --filter @offscreen/chamber start --evaluation-run",
    "storyteller:packet-audit": "pnpm --filter @offscreen/storyteller build && node scripts/repo-tools/storyteller-request-audit.mjs",
    "memory:index-benchmark": "pnpm --filter @offscreen/documents build && pnpm --filter @offscreen/application build && node scripts/repo-tools/memory-index-benchmark.mjs",
    "chamber:review": "turbo run build --filter=@offscreen/chamber && pnpm --filter @offscreen/chamber review",
    "lint:quality": "eslint --config eslint.quality.config.mjs . --max-warnings 0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "prettier": "3.9.7",
    "turbo": "2.10.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
