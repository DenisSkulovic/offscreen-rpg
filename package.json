{
  "name": "offscreen-rpg",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "node tools/dev-environments/src/cli/dev-tilt.mjs",
    "dev:new": "node tools/dev-environments/src/cli/dev-tilt.mjs new",
    "dev:reserve": "node tools/dev-environments/src/cli/dev-tilt.mjs reserve",
    "dev:attach": "node tools/dev-environments/src/cli/dev-tilt.mjs attach",
    "dev:status": "node tools/dev-environments/src/cli/dev-tilt.mjs status",
    "dev:stop": "node tools/dev-environments/src/cli/dev-tilt.mjs stop",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:fast": "turbo run test:fast --filter=@offscreen/web",
    "test:db": "pnpm --filter @offscreen/db build && pnpm --filter @offscreen/db test:integration",
    "test:auth": "turbo run build --filter=@offscreen/api-integration && pnpm --filter @offscreen/api-integration test:integration",
    "test:stories": "turbo run build --filter=@offscreen/api-integration && pnpm --filter @offscreen/api-integration test:stories",
    "test:focus": "node scripts/repo-tools/focused-integration.mjs",
    "test:longform": "node scripts/repo-tools/longform-acceptance.mjs",
    "db:migrate": "pnpm --filter @offscreen/db build && pnpm --filter @offscreen/db migrate",
    "db:baseline": "node scripts/repo-tools/baseline.mjs",
    "db:reset:test": "node scripts/repo-tools/reset-test-db.mjs",
    "admin:bootstrap-staff": "node scripts/repo-tools/admin-bootstrap-staff.mjs",
    "repo:brief": "node scripts/repo-tools/brief.mjs",
    "repo:snapshot:chatgpt": "node scripts/repo-tools/chatgpt-snapshot.mjs",
    "repo:snapshot:chatgpt:test": "node --test scripts/repo-tools/chatgpt-snapshot.test.mjs",
    "repo:docs-health": "node scripts/repo-tools/docs-health.mjs",
    "repo:maintenance": "node scripts/repo-tools/maintenance.mjs",
    "repo:maintenance:test": "node --test scripts/repo-tools/work-selection.test.mjs scripts/repo-tools/maintenance.test.mjs scripts/repo-tools/archive-changes.test.mjs",
    "repo:code-health": "node scripts/repo-tools/code-health.mjs",
    "repo:code-health:test": "node --test scripts/repo-tools/code-health.test.mjs",
    "repo:module-graph": "node scripts/repo-tools/module-graph.mjs",
    "repo:module-graph:test": "node --test scripts/repo-tools/module-graph.test.mjs",
    "repo:host-domain-imports": "node scripts/repo-tools/host-domain-imports.mjs",
    "repo:host-domain-imports:test": "node --test scripts/repo-tools/host-domain-imports.test.mjs",
    "wiki:health": "node scripts/repo-tools/wiki-health.mjs",
    "wiki:content-health": "node scripts/repo-tools/wiki-content-health.mjs",
    "wiki:graph": "node scripts/repo-tools/wiki-health.mjs --graph",
    "wiki:bench:static": "node scripts/repo-tools/wiki-bench-static.mjs",
    "wiki:change-guard": "node scripts/repo-tools/wiki-change-guard.mjs",
    "wiki:find": "node scripts/repo-tools/wiki-find.mjs",
    "wiki:read": "node scripts/repo-tools/wiki-read.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:web": "eslint \"apps/web/**/*.{ts,tsx}\" --max-warnings 0",
    "lint:web:negatives": "node scripts/repo-tools/web-lint-negatives.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "workload:check": "node --test infra/workloads/tests/*.test.mjs",
    "stack:preflight": "node scripts/repo-tools/stack-preflight.mjs",
    "stack:up": "node scripts/repo-tools/stack.mjs up",
    "stack:status": "node scripts/repo-tools/stack.mjs status",
    "stack:down": "node scripts/repo-tools/stack.mjs down",
    "stack:reset": "node scripts/repo-tools/stack.mjs reset",
    "stack:acceptance": "node scripts/repo-tools/stack-acceptance.mjs",
    "stack:acceptance:test": "node --test scripts/repo-tools/stack-acceptance.test.mjs",
    "infra:plan": "node infra/environments/infra-cli.mjs plan",
    "infra:up": "node infra/environments/infra-cli.mjs up",
    "infra:status": "node infra/environments/infra-cli.mjs status",
    "infra:repair": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/repo-tools/repair-docker-desktop.ps1",
    "infra:verify": "node infra/verification/verify.mjs",
    "fixture:import": "node scripts/repo-tools/import-pinned-fixture.mjs",
    "lint:quality": "eslint --config eslint.quality.config.mjs . --max-warnings 0",
    "repo:commit:check:test": "node --test scripts/repo-tools/check-commit-message.test.mjs",
    "repo:hooks:install": "node scripts/repo-tools/install-git-hooks.mjs",
    "repo:commit:check": "node scripts/repo-tools/check-commit-message.mjs",
    "repo:cursor-usage": "node scripts/repo-tools/cursor-usage-window.mjs",
    "repo:cursor-usage:test": "node --test scripts/repo-tools/cursor-usage-window.test.mjs",
    "repo:retirement": "node scripts/repo-tools/retirement-health.mjs",
    "repo:retirement:test": "node --test scripts/repo-tools/retirement-health.test.mjs",
    "repo:change-branch": "node scripts/repo-tools/change-branch-guard.mjs",
    "repo:change-branch:test": "node --test scripts/repo-tools/change-branch-guard.test.mjs",
    "repo:code-quality:changed": "node scripts/repo-tools/changed-code-quality.mjs",
    "repo:code-quality:changed:test": "node --test scripts/repo-tools/changed-code-quality.test.mjs",
    "repo:affected": "node scripts/repo-tools/affected-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.5",
    "@tanstack/eslint-plugin-query": "5.91.2",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "prettier": "3.9.7",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "turbo": "2.10.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "unified": "^11.0.5"
  }
}
