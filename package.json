{
  "name": "offscreen-rpg",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:db": "pnpm --filter @offscreen/db build && pnpm --filter @offscreen/db test:integration",
    "test:auth": "turbo run build --filter=@offscreen/api --filter=@offscreen/web && pnpm --filter @offscreen/api test:integration",
    "db:migrate": "pnpm --filter @offscreen/db build && pnpm --filter @offscreen/db migrate",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "chamber": "turbo run build --filter=@offscreen/api --filter=@offscreen/web && pnpm --filter @offscreen/api chamber",
    "lint:quality": "eslint --config eslint.quality.config.mjs . --max-warnings 0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "prettier": "3.9.7",
    "turbo": "2.10.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
