{
  "name": "offscreen-rpg",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:fast": "turbo run test:fast --filter=@offscreen/web",
    "test:db": "pnpm --filter @offscreen/db build && pnpm --filter @offscreen/db test:integration",
    "test:auth": "turbo run build --filter=@offscreen/api-integration && pnpm --filter @offscreen/api-integration test:integration",
    "test:stories": "turbo run build --filter=@offscreen/api-integration && pnpm --filter @offscreen/api-integration test:stories",
    "test:focus": "node scripts/repo-tools/focused-integration.mjs",
    "db:migrate": "pnpm --filter @offscreen/db build && pnpm --filter @offscreen/db migrate",
    "db:baseline": "node scripts/repo-tools/baseline.mjs",
    "db:reset:test": "node scripts/repo-tools/reset-test-db.mjs",
    "admin:bootstrap-staff": "node scripts/repo-tools/admin-bootstrap-staff.mjs",
    "repo:brief": "node scripts/repo-tools/brief.mjs",
    "repo:snapshot:chatgpt": "node scripts/repo-tools/chatgpt-snapshot.mjs",
    "repo:snapshot:chatgpt:test": "node --test scripts/repo-tools/chatgpt-snapshot.test.mjs",
    "repo:docs-health": "node scripts/repo-tools/docs-health.mjs",
    "repo:maintenance": "node scripts/repo-tools/maintenance.mjs",
    "repo:maintenance:test": "node --test scripts/repo-tools/work-selection.test.mjs scripts/repo-tools/maintenance.test.mjs scripts/repo-tools/archive-changes.test.mjs",
    "wiki:health": "node scripts/repo-tools/wiki-health.mjs",
    "wiki:content-health": "node scripts/repo-tools/wiki-content-health.mjs",
    "wiki:graph": "node scripts/repo-tools/wiki-health.mjs --graph",
    "wiki:bench:static": "node scripts/repo-tools/wiki-bench-static.mjs",
    "wiki:change-guard": "node scripts/repo-tools/wiki-change-guard.mjs",
    "wiki:find": "node scripts/repo-tools/wiki-find.mjs",
    "wiki:read": "node scripts/repo-tools/wiki-read.mjs",
    "infra": "node scripts/repo-tools/compose.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:web": "eslint \"apps/web/**/*.{ts,tsx}\" --max-warnings 0",
    "lint:web:negatives": "node scripts/repo-tools/web-lint-negatives.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "node scripts/repo-tools/compose.mjs up -d --wait",
    "infra:down": "node scripts/repo-tools/compose.mjs down",
    "infra:repair": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/repo-tools/repair-docker-desktop.ps1",
    "chamber": "turbo run build --filter=@offscreen/chamber && pnpm --filter @offscreen/chamber start",
    "chamber:bench": "pnpm --filter @offscreen/game build && pnpm --filter @offscreen/contracts build && pnpm --filter @offscreen/application build && pnpm --filter @offscreen/chamber build && pnpm --filter @offscreen/chamber bench",
    "chamber:scenario": "pnpm --filter @offscreen/game build && pnpm --filter @offscreen/contracts build && pnpm --filter @offscreen/application build && pnpm --filter @offscreen/chamber build && pnpm --filter @offscreen/chamber scenario",
    "chamber:inspect": "pnpm --filter @offscreen/game build && pnpm --filter @offscreen/contracts build && pnpm --filter @offscreen/application build && pnpm --filter @offscreen/chamber build && pnpm --filter @offscreen/chamber inspect",
    "story:local": "turbo run build --filter=@offscreen/chamber && pnpm --filter @offscreen/chamber start --story-mode",
    "story:server": "turbo run build --filter=@offscreen/chamber && pnpm --filter @offscreen/chamber start --story-mode --no-browser",
    "story:play": "node scripts/repo-tools/story-play.mjs",
    "story:inspect": "node scripts/repo-tools/story-session-report.mjs",
    "fixture:import": "node scripts/repo-tools/import-pinned-fixture.mjs",
    "chamber:reset": "turbo run build --filter=@offscreen/chamber && pnpm --filter @offscreen/chamber start --reset-database",
    "chamber:packet": "turbo run build --filter=@offscreen/chamber && pnpm --filter @offscreen/chamber start --packet-review",
    "chamber:memory-packet": "turbo run build --filter=@offscreen/chamber && pnpm --filter @offscreen/chamber start --memory-packet-review",
    "chamber:memory-comparison-packets": "turbo run build --filter=@offscreen/chamber && pnpm --filter @offscreen/chamber start --memory-comparison-packets",
    "chamber:memory-evaluation-packet": "turbo run build --filter=@offscreen/chamber && pnpm --filter @offscreen/chamber start --memory-evaluation-packet",
    "chamber:memory-evaluation-run": "turbo run build --filter=@offscreen/chamber && pnpm --filter @offscreen/chamber start --memory-evaluation-run",
    "chamber:evaluation-packet": "turbo run build --filter=@offscreen/chamber && pnpm --filter @offscreen/chamber start --evaluation-packet",
    "chamber:evaluation-run": "turbo run build --filter=@offscreen/chamber && pnpm --filter @offscreen/chamber start --evaluation-run",
    "storyteller:packet-audit": "pnpm --filter @offscreen/storyteller build && node scripts/repo-tools/storyteller-request-audit.mjs",
    "storyteller:playability": "pnpm --filter @offscreen/storyteller build && pnpm --filter @offscreen/application build && node scripts/repo-tools/storyteller-playability.mjs",
    "storyteller:live-comparison": "pnpm --filter @offscreen/contracts build && pnpm --filter @offscreen/application build && node scripts/repo-tools/storyteller-live-comparison.mjs",
    "memory:index-benchmark": "pnpm --filter @offscreen/documents build && pnpm --filter @offscreen/application build && node scripts/repo-tools/memory-index-benchmark.mjs",
    "chamber:review": "turbo run build --filter=@offscreen/chamber && pnpm --filter @offscreen/chamber review",
    "lint:quality": "eslint --config eslint.quality.config.mjs . --max-warnings 0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.5",
    "@tanstack/eslint-plugin-query": "5.91.2",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "prettier": "3.9.7",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "turbo": "2.10.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "unified": "^11.0.5"
  }
}
