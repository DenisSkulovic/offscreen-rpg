{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode"],
  "properties": {
    "mode": { "type": "string", "enum": ["development", "release"] },
    "section": {
      "type": "string",
      "enum": ["all", "deployments", "namespaces", "services", "migration", "edge", "authority", "workers"]
    },
    "catalog": { "type": "object" },
    "replicas": { "type": "integer", "minimum": 1 },
    "imagePullPolicy": { "type": "string" },
    "automountServiceAccountToken": { "type": "boolean" },
    "enableServiceLinks": { "type": "boolean" },
    "podSecurity": { "type": "object" },
    "readiness": { "type": "object" },
    "resources": { "type": "object" },
    "workingDirs": { "type": "object" },
    "commands": { "type": "object" },
    "watched": { "type": "object" },
    "dev": { "type": "object" },
    "namespaces": { "type": "object" },
    "images": { "type": "object" },
    "workerCommands": { "type": "object" },
    "release": { "type": "object" },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slotId": { "type": "string", "pattern": "^dev-[1-9][0-9]*$" },
        "namespace": { "type": "string", "minLength": 1 },
        "gamePort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "cookiePrefix": { "type": "string", "minLength": 1 },
        "dbPoolMax": { "type": "integer", "minimum": 1 },
        "s3Bucket": { "type": "string", "minLength": 1 },
        "s3Endpoint": { "type": "string", "minLength": 1 },
        "temporalAddress": { "type": "string", "minLength": 1 },
        "temporalNamespace": { "type": "string", "minLength": 1 },
        "dbSecret": { "type": "string", "minLength": 1 },
        "appSecret": { "type": "string", "minLength": 1 },
        "s3Secret": { "type": "string", "minLength": 1 },
        "receiptDir": { "type": "string", "minLength": 1 },
        "images": {
          "type": "object",
          "additionalProperties": false,
          "required": ["web", "api", "authority", "worker"],
          "properties": {
            "web": { "type": "string" },
            "api": { "type": "string" },
            "authority": { "type": "string" },
            "worker": { "type": "string" }
          }
        },
        "schemaReady": { "type": "boolean" },
        "authorityOrigin": { "type": "string" },
        "apiOrigin": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "development" } }, "required": ["mode"] },
      "then": {
        "required": ["bindings", "commands", "workingDirs", "watched", "dev"],
        "properties": {
          "bindings": {
            "required": [
              "slotId",
              "namespace",
              "gamePort",
              "cookiePrefix",
              "dbPoolMax",
              "s3Bucket",
              "s3Endpoint",
              "temporalAddress",
              "temporalNamespace",
              "dbSecret",
              "appSecret",
              "s3Secret",
              "receiptDir",
              "images",
              "schemaReady",
              "authorityOrigin",
              "apiOrigin"
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "mode": { "const": "release" } }, "required": ["mode"] },
      "then": {
        "required": ["namespaces", "images", "release", "workerCommands"],
        "properties": {
          "bindings": { "maxProperties": 0 }
        }
      }
    }
  ]
}