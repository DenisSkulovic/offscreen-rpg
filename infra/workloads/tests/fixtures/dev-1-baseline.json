      "name": "offscreen-dev-1",
      "labels": {
        "app": "slot",
        "offscreen.dev/slot": "dev-1",
        "offscreen.dev/owner": "offscreen-dev",
        "offscreen.rpg/profile": "dev-slot"
      }
    }
  },
  {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
      "name": "game-web",
      "namespace": "offscreen-dev-1",
      "labels": {
        "app": "game-web",
        "offscreen.dev/slot": "dev-1",
        "offscreen.dev/owner": "offscreen-dev",
        "offscreen.rpg/profile": "dev-slot"
      }
    },
    "spec": {
      "type": "ClusterIP",
      "selector": {
        "app": "game-web",
        "offscreen.dev/slot": "dev-1"
      },
      "ports": [
        {
          "name": "http",
          "port": 3000,
          "targetPort": "http"
        }
      ]
    }
  },
  {
    "apiVersion": "v1",
