  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "name": "game-web",
      "namespace": "offscreen-dev-1",
      "labels": {
        "app": "game-web",
        "offscreen.dev/slot": "dev-1",
        "offscreen.dev/owner": "offscreen-dev",
        "offscreen.rpg/profile": "dev-slot"
      }
    },
    "spec": {
      "replicas": 1,
      "selector": {
        "matchLabels": {
          "app": "game-web",
          "offscreen.dev/slot": "dev-1"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "app": "game-web",
            "offscreen.dev/slot": "dev-1",
            "offscreen.dev/owner": "offscreen-dev",
            "offscreen.rpg/profile": "dev-slot"
          }
        },
        "spec": {
          "automountServiceAccountToken": false,
          "enableServiceLinks": false,
          "containers": [
            {
              "name": "web",
              "image": "offscreen-dev-workspace:dev-1-web",
              "imagePullPolicy": "Never",
              "workingDir": "/app/apps/web",
              "command": [
                "sh",
                "-c",
                "node dev-pod-web-receipt.mjs & exec pnpm exec next dev --hostname 0.0.0.0 --port 3000"
              ],
              "ports": [
                {
                  "name": "http",
                  "containerPort": 3000
                }
              ],
              "env": [
                {
                  "name": "OFFSCREEN_DEV_SLOT",
                  "value": "dev-1"
                },
                {
                  "name": "OFFSCREEN_DEV_RUNTIME_RECEIPT_DIR",
                  "value": "/tmp/offscreen-dev-runtime"
                },
                {
                  "name": "API_PROXY_ORIGIN",
                  "value": "http://game-api.offscreen-dev-1.svc.cluster.local:3001"
                },
                {
                  "name": "API_INTERNAL_ORIGIN",
                  "value": "http://game-api.offscreen-dev-1.svc.cluster.local:3001"
                }
              ]
            }
          ]
        }
      }
    }
  },
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "name": "game-api",
      "namespace": "offscreen-dev-1",
      "labels": {
        "app": "game-api",
        "offscreen.dev/slot": "dev-1",
        "offscreen.dev/owner": "offscreen-dev",
        "offscreen.rpg/profile": "dev-slot"
      }
    },
    "spec": {
      "replicas": 1,
      "selector": {
        "matchLabels": {
          "app": "game-api",
          "offscreen.dev/slot": "dev-1"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "app": "game-api",
            "offscreen.dev/slot": "dev-1",
            "offscreen.dev/owner": "offscreen-dev",
            "offscreen.rpg/profile": "dev-slot"
          }
        },
        "spec": {
          "automountServiceAccountToken": false,
          "enableServiceLinks": false,
          "containers": [
            {
              "name": "api",
              "image": "offscreen-dev-workspace:dev-1-api",
              "imagePullPolicy": "Never",
              "workingDir": "/app/apps/api",
              "command": [
                "node",
                "dev-pod-compile-watch.mjs",
                "api",
                "dist/src/main.js"
              ],
              "ports": [
                {
                  "name": "http",
                  "containerPort": 3001
                }
              ],
              "env": [
                {
                  "name": "OFFSCREEN_DEV_SLOT",
                  "value": "dev-1"
                },
                {
                  "name": "OFFSCREEN_DEV_WATCHED_COMPILATION",
                  "value": "1"
                },
                {
                  "name": "OFFSCREEN_DEV_COMPILED_ENTRY",
                  "value": "/app/apps/api/dist/src/main.js"
                },
                {
                  "name": "OFFSCREEN_DEV_RUNTIME_RECEIPT_DIR",
                  "value": "/tmp/offscreen-dev-runtime"
                },
                {
                  "name": "OFFSCREEN_DEV_RECEIPT_ROLE",
                  "value": "api"
                },
                {
                  "name": "DB_POOL_MAX",
                  "value": "2"
                },
                {
                  "name": "APP_ORIGIN",
                  "value": "http://127.0.0.1:3100"
                },
                {
                  "name": "BETTER_AUTH_COOKIE_PREFIX",
                  "value": "dev-1"
                },
                {
                  "name": "GAME_AUTHORITY_ORIGIN",
                  "value": "http://game-authority.offscreen-dev-1.svc.cluster.local:3002"
                },
                {
                  "name": "GAME_AUTHORITY_MODE",
                  "value": "distributed"
                },
                {
                  "name": "API_HOST",
                  "value": "0.0.0.0"
                },
                {
                  "name": "API_PORT",
                  "value": "3001"
                },
                {
                  "name": "OFFSCREEN_DOCUMENT_STORE",
                  "value": "s3"
                },
                {
                  "name": "OFFSCREEN_DOCUMENT_S3_BUCKET",
                  "value": "offscreen-dev-1"
                },
                {
                  "name": "OFFSCREEN_DOCUMENT_S3_ENDPOINT",
                  "value": "http://object-store.offscreen-dev-objects.svc.cluster.local:8333"
                },
                {
                  "name": "DATABASE_URL",
                  "valueFrom": {
                    "secretKeyRef": {
                      "name": "dev-1-run-auth",
                      "key": "uri"
                    }
                  }
                },
                {
                  "name": "OFFSCREEN_DOCUMENT_S3_ACCESS_KEY_ID",
                  "valueFrom": {
                    "secretKeyRef": {
                      "name": "dev-1-s3",
                      "key": "access-key-id"
                    }
                  }
                },
                {
                  "name": "OFFSCREEN_DOCUMENT_S3_SECRET_ACCESS_KEY",
                  "valueFrom": {
                    "secretKeyRef": {
                      "name": "dev-1-s3",
                      "key": "secret-access-key"
                    }
                  }
                },
                {
                  "name": "GAME_AUTHORITY_SERVICE_TOKEN",
                  "valueFrom": {
                    "secretKeyRef": {
                      "name": "dev-1-app",
                      "key": "game-authority-service-token"
                    }
                  }
                },
                {
                  "name": "BETTER_AUTH_SECRET",
                  "valueFrom": {
                    "secretKeyRef": {
                      "name": "dev-1-app",
                      "key": "better-auth-secret"
                    }
                  }
                },
                {
                  "name": "GITHUB_CLIENT_ID",
                  "valueFrom": {
                    "secretKeyRef": {
                      "name": "dev-1-app",
                      "key": "github-client-id"
                    }
                  }
                },
                {
                  "name": "GITHUB_CLIENT_SECRET",
                  "valueFrom": {
                    "secretKeyRef": {
                      "name": "dev-1-app",
                      "key": "github-client-secret"
                    }
                  }
                }
              ]
            }
          ]
        }
      }
    }
  },
