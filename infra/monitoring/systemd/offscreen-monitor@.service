# offscreen-monitor-managed: v1
[Unit]
Description=Offscreen workstation monitor companion for %i
Documentation=file:/usr/local/lib/offscreen-monitor/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
Group=%i
WorkingDirectory=/usr/local/lib/offscreen-monitor
ExecStart=/usr/bin/python3 -m offscreen_monitor.collector --config /etc/offscreen-monitor/%i.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target