# DXK08 developer lab graph (pnpm dev / root Tiltfile).
# Release image builds and TURN02 overlays: infra/kubernetes/lab/app-release/Tiltfile.

OFFSCREEN_DEV_SLOT = os.getenv('OFFSCREEN_DEV_SLOT', 'unassigned')
OFFSCREEN_DEV_NAMESPACE = os.getenv('OFFSCREEN_DEV_NAMESPACE', 'unassigned')
OFFSCREEN_DEV_GAME_PORT = os.getenv('OFFSCREEN_DEV_GAME_PORT', '3000')
SLOT_SESSION = OFFSCREEN_DEV_SLOT.startswith('dev-')

# A slot session syncs into the images already running in that slot.
# The lab manifests stay on the unassigned DXK08 path so `tilt up` cannot
# create lab-edge inside kind-offscreen-dev.
if SLOT_SESSION:
    DEV_WORKSPACE_IMAGE = 'offscreen-dev-workspace:' + OFFSCREEN_DEV_SLOT + '-web'
    DEV_WORKSPACE_API_IMAGE = 'offscreen-dev-workspace:' + OFFSCREEN_DEV_SLOT + '-api'
    DEV_WORKSPACE_GA_IMAGE = 'offscreen-dev-workspace:' + OFFSCREEN_DEV_SLOT + '-authority'
    DEV_WORKSPACE_WORKER_IMAGE = 'offscreen-dev-workspace:' + OFFSCREEN_DEV_SLOT + '-worker'
else:
    DEV_WORKSPACE_IMAGE = 'offscreen-lab-dev-workspace:dxk08'
    DEV_WORKSPACE_API_IMAGE = 'offscreen-lab-dev-workspace:dxk08-api'
    DEV_WORKSPACE_GA_IMAGE = 'offscreen-lab-dev-workspace:dxk08-game-authority'
    DEV_WORKSPACE_WORKER_IMAGE = 'offscreen-lab-dev-workspace:dxk08-worker'
# config.main_dir is the root Tiltfile directory. Paths passed to docker_build(only=)
# must sit inside that context; a relative climb made COPY tools fail checksum.
REPO_ROOT = config.main_dir

# A directory in docker_build(only=) is a watch input. If a changed file inside it
# is not covered by sync(), Tilt rebuilds the image. Listing `apps` made an API
# .ts edit rebuild the web image. Each image watches only its sync closure plus
# the build-critical files that fall_back_on already names.
BUILD_ROOTS = [
    'package.json',
    'pnpm-lock.yaml',
    'pnpm-workspace.yaml',
    'turbo.json',
    'infra/kubernetes/lab/app-release/docker.npmrc',
    'infra/kubernetes/lab/dev/Dockerfile',
    # tsconfig extends this package. It is not a production runtime closure entry.
    'packages/config',
]

TURBO_FILTER_BY_IMAGE = {
    'web': '@offscreen/web^...',
    'api': '@offscreen/api^...',
    'game-authority': '@offscreen/game-authority^...',
    'worker': '@offscreen/worker^...',
}

SYNC_CONFIG = decode_json(str(local(
    'node infra/kubernetes/lab/dev/dev-sync-paths.mjs --tilt',
    dir=REPO_ROOT,
    quiet=True,
)).strip())

def repo_path(rel):
    return REPO_ROOT + '/' + rel

UNSAFE_FALLBACK = [repo_path(rel) for rel in SYNC_CONFIG['unsafe_fall_back']]
WARM_WATCH = [repo_path(rel) for rel in SYNC_CONFIG['unsafe_watch_paths']]

local_resource(
    'dev-warm-release-fallback',
    cmd='cd ' + REPO_ROOT + ' && ' + SYNC_CONFIG['warm_release_cmd'],
    deps=WARM_WATCH + [REPO_ROOT + '/infra/kubernetes/lab/dev/dev-sync-paths.mjs'],
    ignore=['**/node_modules', '**/dist', '**/.next'],
    auto_init=False,
    labels=['dev-fallback'],
)

def fallbacks_under(watched):
    kept = []
    for rel in UNSAFE_FALLBACK:
        for watch in watched:
            base = watch.rstrip('/')
            if rel == base or rel.startswith(base + '/'):
                kept.append(rel)
                break
    return kept

def dev_live_update(image_key, watched):
    steps = []
    fallbacks = fallbacks_under(watched)
    if len(fallbacks) > 0:
        steps.append(fall_back_on(fallbacks))
    for sub in SYNC_CONFIG['sync_dirs_by_image'][image_key]:
        steps.append(sync(REPO_ROOT + sub, '/app' + sub))
    # App watchers import this module. It is outside each app sync closure.
    for receipt in [
        '/infra/kubernetes/lab/dev/dev-watched-compilation-receipt.mjs',
        '/infra/kubernetes/lab/dev/dev-watch-compilation.mjs',
        '/infra/kubernetes/lab/dev/dev-image-runtime-modules.mjs',
    ]:
        steps.append(sync(REPO_ROOT + receipt, '/app' + receipt))
    return steps

def image_inputs(image_key):
    paths = list(BUILD_ROOTS)
    for rel in SYNC_CONFIG['unsafe_fall_back']:
        paths.append(rel)
    for sub in SYNC_CONFIG['sync_dirs_by_image'][image_key]:
        paths.append(sub[1:])
    return paths

def dev_workspace_docker_build(image, image_key):
    inputs = image_inputs(image_key)
    for rel in [
        'infra/kubernetes/lab/dev/dev-watched-compilation-receipt.mjs',
        'infra/kubernetes/lab/dev/dev-watch-compilation.mjs',
        'infra/kubernetes/lab/dev/dev-image-runtime-modules.mjs',
    ]:
        inputs.append(rel)
    watched = [REPO_ROOT + '/' + rel for rel in inputs]
    steps = dev_live_update(image_key, watched)
    # skips_local_docker keeps Tilt from kind-loading in parallel after the build.
    # deps stay on image_inputs so an API .ts file is a sync input, not a web input.
    ref_file = '/tmp/offscreen-tilt-image-ref-' + image_key
    custom_build(
        image,
        'OFFSCREEN_IMAGE_REF_FILE=' + ref_file + ' bash ' + REPO_ROOT + '/infra/kubernetes/lab/dev/tilt/load-dev-image.sh ' + TURBO_FILTER_BY_IMAGE[image_key] + ' ' + image,
        deps=watched,
        ignore=['**/node_modules', '**/dist', '**/.next'],
        live_update=steps,
        skips_local_docker=True,
        outputs_image_ref_to=ref_file,
    )

dev_workspace_docker_build(DEV_WORKSPACE_IMAGE, 'web')
if os.getenv('OFFSCREEN_DEV_TILT_ROLE', '') != 'web':
    dev_workspace_docker_build(DEV_WORKSPACE_API_IMAGE, 'api')
    dev_workspace_docker_build(DEV_WORKSPACE_GA_IMAGE, 'game-authority')
    dev_workspace_docker_build(DEV_WORKSPACE_WORKER_IMAGE, 'worker')

if SLOT_SESSION:
    # Declarative slot Deployments. Live `kubectl get` copies resourceVersion and
    # managedFields, and those collide with the next image roll.
    rendered = local(
        'node tools/dev-environments/src/rendering/dev-slot-app-graph.mjs --tilt-deployments',
        dir=REPO_ROOT,
        quiet=True,
    )
    k8s_yaml(rendered)
    for name in ['game-web', 'game-api', 'game-authority', 'game-control', 'game-executor', 'game-relay']:
        k8s_resource(name)
else:
    k8s_yaml('infra/workloads/dev/web.yaml')
    k8s_yaml('infra/workloads/dev/api.yaml')
    k8s_yaml('infra/workloads/dev/authority.yaml')
    k8s_yaml('infra/workloads/dev/workers.yaml')
    k8s_resource(
        'game-web',
        port_forwards=['127.0.0.1:' + OFFSCREEN_DEV_GAME_PORT + ':3000'],
    )
    k8s_resource(
        'game-api',
        port_forwards=['127.0.0.1:3001:3001'],
    )
    k8s_resource(
        'game-authority',
        port_forwards=['127.0.0.1:3002:3002'],
    )
    k8s_resource('game-control')
    k8s_resource('game-executor')
    k8s_resource('game-relay')