# syntax=docker/dockerfile:1
# Build context: `turbo prune @offscreen/api --docker` (json/ + full/) plus app-release helpers.
# Manifests and the lockfile are installed before source so a TypeScript edit reuses pnpm fetch.
FROM docker.io/library/node:24.19.0-bookworm-slim@sha256:a9f5f7c91a432850b2a8a7797adf5eadb6c733ceed61167806cee7ea7fbc29df AS builder
WORKDIR /app
ENV PNPM_HOME=/pnpm
ENV PATH=/pnpm:$PATH
ENV CI=true
RUN corepack enable && corepack prepare pnpm@11.19.0 --activate
COPY docker.npmrc .npmrc
COPY json/ ./
RUN --mount=type=cache,id=offscreen-pnpm-store,target=/pnpm/store \
    pnpm fetch --frozen-lockfile
RUN --mount=type=cache,id=offscreen-pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --offline
COPY full/ ./
COPY infra/kubernetes/lab/app-release/prepare-runtime-tree.sh \
  infra/kubernetes/lab/app-release/production-workspace-closure.mjs \
  infra/kubernetes/lab/app-release/release-process-env-shim.mjs \
  infra/kubernetes/lab/app-release/
RUN pnpm --filter @offscreen/api... build
RUN bash infra/kubernetes/lab/app-release/prepare-runtime-tree.sh apps/api /runtime

FROM docker.io/library/node:24.19.0-bookworm-slim@sha256:a9f5f7c91a432850b2a8a7797adf5eadb6c733ceed61167806cee7ea7fbc29df AS runtime
WORKDIR /app
# Pod release binds all interfaces; do not mount source content at runtime.
ENV NODE_ENV=production
ENV API_HOST=0.0.0.0
ENV API_PORT=3001
RUN chown -R node:node /app
USER node
COPY --from=builder --chown=node:node /runtime /app
EXPOSE 3001
CMD ["node", "--import", "./release-process-env-shim.mjs", "apps/api/dist/src/main.js"]