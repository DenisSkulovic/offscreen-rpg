# Real lab app release for kind-offscreen-lab: build app-release images and apply
# Helm-rendered release workloads. Invoke with: tilt up -f infra/environments/release/Tiltfile
# Does not use Docker Compose or gateway synthetic skeleton workloads.
#
# Schema migrations and first-time Secrets still require infra/environments/release/install.sh.
# Do not run install.sh and this Tiltfile as concurrent release writers against the same cluster.

allow_k8s_contexts('kind-offscreen-lab')

# Image builds call the release scripts and can exceed the 5 minute CI default.
ci_settings(timeout='45m', readiness_timeout='45m')
update_settings(max_parallel_updates=1)

REPO_ROOT = config.main_dir

WEB_IMAGE = 'offscreen-lab-game-web:turn02'
API_IMAGE = 'offscreen-lab-app-release-api:turn02'
GA_IMAGE = 'offscreen-lab-app-release-ga:turn02'
WORKER_IMAGE = 'offscreen-lab-app-release-worker:turn02'

RELEASE_BUILD_DEPS = [
    REPO_ROOT + '/apps',
    REPO_ROOT + '/packages',
    REPO_ROOT + '/tools',
    REPO_ROOT + '/package.json',
    REPO_ROOT + '/pnpm-lock.yaml',
    REPO_ROOT + '/pnpm-workspace.yaml',
    REPO_ROOT + '/turbo.json',
    REPO_ROOT + '/infra/images/common',
    REPO_ROOT + '/infra/images/release',
    REPO_ROOT + '/infra/images/release/build-release-images.sh',
    REPO_ROOT + '/infra/images/distribution/kind-image-loader.mjs',
]

RELEASE_BUILD_IGNORE = [
    '**/node_modules',
    '**/dist',
    '**/.next',
    'out',
]

# Operator convenience: build every release image in one command.
local_resource(
    'app-release-images',
    cmd='cd ' + REPO_ROOT + ' && bash infra/images/release/build-release-images.sh',
    deps=RELEASE_BUILD_DEPS,
    ignore=RELEASE_BUILD_IGNORE,
)

def release_image_build(ref, image_key, stable_ref):
    custom_build(
        ref,
        'cd ' + REPO_ROOT + ' && env -u OFFSCREEN_AFFECTED_BASE OFFSCREEN_RELEASE_IMAGES=' + image_key + ' bash infra/images/release/build-release-images.sh && docker tag ' + stable_ref + ' "$EXPECTED_REF" && node infra/images/distribution/kind-image-loader.mjs release "$EXPECTED_REF"',
        deps=RELEASE_BUILD_DEPS,
        ignore=RELEASE_BUILD_IGNORE,
        skips_local_docker=True,
    )

release_image_build(WEB_IMAGE, 'web', WEB_IMAGE)
release_image_build(API_IMAGE, 'api', API_IMAGE)
release_image_build(GA_IMAGE, 'game-authority', GA_IMAGE)
release_image_build(WORKER_IMAGE, 'worker', WORKER_IMAGE)

watch_file(REPO_ROOT + '/infra/workloads/render.mjs')
watch_file(REPO_ROOT + '/infra/workloads/profiles/release.yaml')
watch_file(REPO_ROOT + '/infra/workloads/chart/Chart.yaml')
watch_file(REPO_ROOT + '/infra/workloads/chart/values.yaml')
watch_file(REPO_ROOT + '/infra/workloads/chart/values.schema.json')
watch_file(REPO_ROOT + '/infra/environments/release/game-edge-route.yaml')

release_manifests = local(
    'node infra/workloads/render.mjs release all',
    dir=REPO_ROOT,
    quiet=True,
)
k8s_yaml(release_manifests)
k8s_yaml(REPO_ROOT + '/infra/environments/release/game-edge-route.yaml')

k8s_resource('game-authority')

k8s_resource(
    'game-api',
    resource_deps=['game-authority'],
)

k8s_resource(
    'game-web',
    resource_deps=['game-api'],
    port_forwards=['127.0.0.1:3000:3000'],
)

k8s_resource(
    'game-control',
    resource_deps=['game-authority'],
)

k8s_resource(
    'game-executor',
    resource_deps=['game-authority'],
)

k8s_resource(
    'game-relay',
    resource_deps=['game-authority'],
)