{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "redis", "resources", "owner"],
  "properties": {
    "image": {
      "type": "string",
      "const": "docker.io/library/redis@sha256:987c376c727652f99625c7d205a1cba3cb2c53b92b0b62aade2bd48ee1593232"
    },
    "redis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxmemoryMiB", "evictionPolicy"],
      "properties": {
        "maxmemoryMiB": { "type": "integer", "const": 32 },
        "evictionPolicy": { "type": "string", "const": "allkeys-lru" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpuMilli", "memoryMiB"],
          "properties": {
            "cpuMilli": { "type": "integer", "const": 20 },
            "memoryMiB": { "type": "integer", "const": 32 }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpuMilli", "memoryMiB"],
          "properties": {
            "cpuMilli": { "type": "integer", "const": 500 },
            "memoryMiB": { "type": "integer", "const": 128 }
          }
        }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": {
          "type": "string",
          "enum": ["offscreen.dev/owner", "offscreen.rpg/lab"]
        },
        "value": {
          "type": "string",
          "enum": ["offscreen-dev", "disposable"]
        }
      },
      "oneOf": [
        {
          "properties": {
            "key": { "const": "offscreen.dev/owner" },
            "value": { "const": "offscreen-dev" }
          },
          "required": ["key", "value"]
        },
        {
          "properties": {
            "key": { "const": "offscreen.rpg/lab" },
            "value": { "const": "disposable" }
          },
          "required": ["key", "value"]
        }
      ]
    }
  }
}
