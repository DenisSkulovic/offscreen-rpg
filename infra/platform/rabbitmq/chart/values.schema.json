{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["mode", "namespace", "section", "images"],
  "properties": {
    "mode": { "enum": ["release"] },
    "namespace": { "type": "string", "minLength": 1 },
    "section": { "enum": ["all", "namespace", "broker"] },
    "images": {
      "type": "object",
      "required": ["broker"],
      "properties": {
        "broker": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}