{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "mode",
    "namespace",
    "clusterName",
    "section",
    "instances",
    "storage",
    "resources",
    "postgresql",
    "bootstrap"
  ],
  "properties": {
    "mode": { "enum": ["development", "release"] },
    "namespace": { "type": "string", "minLength": 1 },
    "clusterName": { "type": "string", "minLength": 1 },
    "section": { "type": "string", "minLength": 1 },
    "instances": { "type": "integer", "minimum": 1 },
    "namespaceLabels": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "clusterLabels": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "storage": {
      "type": "object",
      "required": ["size", "storageClass"],
      "properties": {
        "size": { "type": "string", "minLength": 1 },
        "storageClass": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": {
          "type": "object",
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": { "type": "string" },
            "memory": { "type": "string" }
          },
          "additionalProperties": false
        },
        "limits": {
          "type": "object",
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": { "type": "string" },
            "memory": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "postgresql": {
      "type": "object",
      "required": ["parameters"],
      "properties": {
        "parameters": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "bootstrap": {
      "type": "object",
      "required": ["initdb"],
      "properties": {
        "initdb": {
          "type": "object",
          "required": ["database", "owner", "localeCType", "localeCollate"],
          "properties": {
            "database": { "type": "string" },
            "owner": { "type": "string" },
            "localeCType": { "type": "string" },
            "localeCollate": { "type": "string" },
            "postInitSQL": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "postInitApplicationSQL": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "images": {
      "type": "object",
      "properties": {
        "postgres": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
