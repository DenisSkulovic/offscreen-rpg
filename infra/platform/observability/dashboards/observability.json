      "type": "timeseries",
      "title": "Observed watch results over five minutes",
      "description": "Observed watch results over five minutes. Missing error series is not proof of absence of errors.",
      "datasource": {
        "type": "prometheus",
        "uid": "offscreen-metrics"
      },
      "gridPos": {
