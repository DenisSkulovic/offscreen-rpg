  "panels": [
    {
      "id": 1000,
      "type": "text",
      "title": "Scope and freshness",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Freshness rule: a current target is `up == 1` with sample age at most 90s. Missing or stale samples are unknown, never healthy and never zero. `up` is scrape availability only, not backend health.\n\nSelf-health panels show the fixed selected signals only. Handler- and route-labelled latency histograms are not enrolled. The Collector exposes no accepted, sent, refused or dropped counters here, so end-to-end delivery and loss are **unsupported, not healthy**. Tempo batch sums are traces observed in batches, not durable ingestion."
      }
    },
    {
      "id": 1001,
      "type": "row",
      "title": "Kube-state-metrics self",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 801,
      "type": "stat",
      "title": "Current self-scrape state, not cache consistency",
      "description": "Current self-scrape state, not cache consistency.",
      "datasource": {
        "type": "prometheus",
        "uid": "offscreen-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "offscreen-metrics"
          },
          "expr": "up{job=\"kube-state-metrics-self\"} and (time() - timestamp(up{job=\"kube-state-metrics-self\"}) <= 90)",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data (unknown, not zero)",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Scrape down",
                  "color": "red",
                  "index": 1
                },
                "1": {
                  "text": "Scrape current",
                  "color": "green",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
