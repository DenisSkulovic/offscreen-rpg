      "description": "Observed namespaces and phase. Cached observation, not definitive API absence; missing/stale unknown.",
      "datasource": {
        "type": "prometheus",
        "uid": "offscreen-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "offscreen-metrics"
          },
          "expr": "(((kube_namespace_status_phase{job=\"kube-state-metrics\"}) and (time() - timestamp(kube_namespace_status_phase{job=\"kube-state-metrics\"}) <= 90)) and on(job,instance) ((up{job=\"kube-state-metrics\"} == 1) and (time() - timestamp(up{job=\"kube-state-metrics\"}) <= 90))) == 1",
          "instant": true,
          "range": false,
          "format": "table"
