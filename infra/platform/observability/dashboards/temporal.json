  "panels": [
    {
      "id": 1000,
      "type": "text",
      "title": "Scope and freshness",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Freshness rule: a current target is `up == 1` with sample age at most 90s. Missing or stale samples are unknown, never healthy and never zero. `up` is scrape availability only, not backend health.\n\n**Partial scope (owner ratified).** Server and persistence families admit namespace-labelled samples for the system and _unknown_ namespaces only, so request, error and latency panels are not all-tenant service metrics. No matching backlog, task-queue or workflow aggregate is provided. A missing worker service series or typed error series is unknown, not zero."
      }
    },
    {
      "id": 1001,
      "type": "row",
      "title": "Server and persistence (admitted platform namespaces only)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 501,
      "type": "stat",
      "title": "Current scrape state only, not backend health",
      "description": "Current scrape state only, not backend health; missing/stale unknown, never synthetic zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "offscreen-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "offscreen-metrics"
          },
          "expr": "up{job=\"temporal-server\"} and (time() - timestamp(up{job=\"temporal-server\"}) <= 90)",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data (unknown, not zero)",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Scrape down",
                  "color": "red",
                  "index": 1
                },
                "1": {
                  "text": "Scrape current",
                  "color": "green",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none"
      }
    },
