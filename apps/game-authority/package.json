{
  "name": "@offscreen/game-authority",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./server": {
      "types": "./dist/src/server.d.ts",
      "default": "./dist/src/server.js"
    },
    "./application": {
      "types": "./dist/src/application.d.ts",
      "default": "./dist/src/application.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=../../.env dist/src/bootstrap/main.js",
    "dev": "tsc-watch --project tsconfig.dev.json --onSuccess \"node --env-file-if-exists=../../.env dist/src/bootstrap/main.js\"",
    "test": "node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@offscreen/runtime-logging": "workspace:*",
    "@offscreen/story-engine": "workspace:*",
    "@offscreen/storyteller": "workspace:*",
    "@offscreen/contracts": "workspace:*",
    "@offscreen/db": "workspace:*",
    "@offscreen/documents": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@offscreen/config": "workspace:*",
    "@types/node": "22.20.3",
    "drizzle-orm": "0.45.2",
    "tsc-watch": "7.2.1",
    "typescript": "5.9.3"
  }
}
