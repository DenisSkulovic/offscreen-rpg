{
  "name": "@offscreen/api",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc-watch --onSuccess \"node --env-file-if-exists=../../.env dist/src/main.js\"",
    "start": "node --env-file-if-exists=../../.env dist/src/main.js",
    "schema:generate": "auth generate --config auth.generate.ts --output ../../packages/db/src/schema/auth.ts --yes",
    "test:integration": "node --test --test-concurrency=1 dist/test/auth.integration.js dist/test/stories.integration.js",
    "test:auth": "node --test dist/test/auth.integration.js",
    "test:stories": "node --test dist/test/stories.integration.js",
    "test:stories:core": "node --test dist/test/stories-core.integration.js",
    "test:stories:http": "node --test dist/test/stories-http.integration.js",
    "test:stories:start": "node --test dist/test/story-start.integration.js",
    "test:stories:resolution": "node --test dist/test/story-resolution.integration.js",
    "test:stories:browser": "node --test dist/test/stories-browser.integration.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/test/*.test.js",
    "chamber": "node dist/dev/chamber.js",
    "test:storyteller": "node --test dist/test/storyteller.integration.js"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.5",
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-express": "12.0.3",
    "@offscreen/contracts": "workspace:*",
    "@offscreen/db": "workspace:*",
    "@offscreen/server": "workspace:*",
    "better-auth": "1.7.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5",
    "@offscreen/storyteller": "workspace:*"
  },
  "devDependencies": {
    "@offscreen/config": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "22.20.3",
    "auth": "1.7.5",
    "playwright": "1.63.0",
    "tsc-watch": "7.2.1",
    "typescript": "5.9.3",
    "@offscreen/worker": "workspace:*",
    "drizzle-orm": "0.45.2"
  }
}
