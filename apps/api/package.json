{
  "name": "@offscreen/api",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "exports": {
    "./app": {
      "types": "./dist/src/app.d.ts",
      "default": "./dist/src/app.js"
    },
    "./auth": {
      "types": "./dist/src/modules/auth/auth.d.ts",
      "default": "./dist/src/modules/auth/auth.js"
    },
    "./auth-config": {
      "types": "./dist/src/modules/auth/config.d.ts",
      "default": "./dist/src/modules/auth/config.js"
    },
    "./config": {
      "types": "./dist/src/config.d.ts",
      "default": "./dist/src/config.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc-watch --onSuccess \"node --env-file-if-exists=../../.env dist/src/main.js\"",
    "start": "node --env-file-if-exists=../../.env dist/src/main.js",
    "schema:generate": "auth generate --config auth.generate.ts --output ../../packages/db/src/schema/auth.ts --yes",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.5",
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-express": "12.0.3",
    "@offscreen/contracts": "workspace:*",
    "@offscreen/db": "workspace:*",
    "@offscreen/application": "workspace:*",
    "@offscreen/cache": "workspace:*",
    "better-auth": "1.7.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5",
    "@offscreen/storyteller": "workspace:*"
  },
  "devDependencies": {
    "@offscreen/config": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "22.20.3",
    "auth": "1.7.5",
    "tsc-watch": "7.2.1",
    "typescript": "5.9.3"
  }
}
