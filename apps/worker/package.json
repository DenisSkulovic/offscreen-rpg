{
  "name": "@offscreen/worker",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./runtime": {
      "types": "./dist/src/runtime/index.d.ts",
      "default": "./dist/src/runtime/index.js"
    },
    "./runtime/control": {
      "types": "./dist/src/runtime/control.d.ts",
      "default": "./dist/src/runtime/control.js"
    },
    "./runtime/execution": {
      "types": "./dist/src/runtime/execution.d.ts",
      "default": "./dist/src/runtime/execution.js"
    },
    "./runtime/storyteller-distributed-live": {
      "types": "./dist/src/runtime/storyteller-distributed-live.d.ts",
      "default": "./dist/src/runtime/storyteller-distributed-live.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=../../.env dist/src/bootstrap/main.js",
    "start:control": "node --env-file-if-exists=../../.env dist/src/bootstrap/control-main.js",
    "start:executor": "node --env-file-if-exists=../../.env dist/src/bootstrap/executor-main.js",
    "dev": "pnpm run dev:relay",
    "dev:relay": "node ../../tools/dev-environments/runtime/compile-watch.mjs worker-relay dist/src/bootstrap/main.js tsconfig.dev.json",
    "dev:control": "node ../../tools/dev-environments/runtime/compile-watch.mjs worker-control dist/src/bootstrap/control-main.js tsconfig.dev.json",
    "dev:executor": "node ../../tools/dev-environments/runtime/compile-watch.mjs worker-executor dist/src/bootstrap/executor-main.js tsconfig.dev.json",
    "test": "node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@offscreen/game-authority-protocol": "workspace:*",
    "@offscreen/lab-support": "workspace:*",
    "@offscreen/runtime-logging": "workspace:*",
    "@offscreen/story-engine": "workspace:*",
    "@offscreen/story-persistence": "workspace:*",
    "@offscreen/db": "workspace:*",
    "@offscreen/documents": "workspace:*",
    "@offscreen/workflows": "workspace:*",
    "@offscreen/storyteller": "workspace:*",
    "drizzle-orm": "0.45.2",
    "@temporalio/client": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "zod": "4.6.5",
    "@offscreen/story-interface": "workspace:*"
  },
  "devDependencies": {
    "@offscreen/config": "workspace:*",
    "@offscreen/game": "workspace:*",
    "@offscreen/game-authority": "workspace:*",
    "@types/node": "22.20.3",
    "tsc-watch": "7.2.1",
    "typescript": "5.9.3"
  }
}
