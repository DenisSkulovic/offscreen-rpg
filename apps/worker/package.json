{
  "name": "@offscreen/worker",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./runtime": {
      "types": "./dist/src/runtime.d.ts",
      "default": "./dist/src/runtime.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=../../.env dist/src/main.js",
    "dev": "tsc-watch --onSuccess \"node --env-file-if-exists=../../.env dist/src/main.js\"",
    "test": "node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@offscreen/db": "workspace:*",
    "@offscreen/application": "workspace:*",
    "@offscreen/workflows": "workspace:*",
    "@temporalio/client": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@offscreen/config": "workspace:*",
    "@types/node": "22.20.3",
    "tsc-watch": "7.2.1",
    "typescript": "5.9.3"
  }
}
