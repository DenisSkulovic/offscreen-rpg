{
  "name": "@offscreen/api-integration",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/test/*.test.js",
    "test:integration": "node --test --test-concurrency=1 dist/test/auth.integration.js dist/test/stories.integration.js",
    "test:auth": "node --test dist/test/auth.integration.js",
    "test:stories": "node --test dist/test/stories.integration.js",
    "test:stories:core": "node --test dist/test/stories-core.integration.js",
    "test:stories:http": "node --test dist/test/stories-http.integration.js",
    "test:stories:start": "node --test dist/test/story-start.integration.js",
    "test:boot03:imported-start-distributed": "node --test dist/test/boot03-imported-start-distributed.integration.js",
    "test:stories:resolution": "node --test dist/test/story-resolution.integration.js",
    "test:stories:browser": "node --test dist/test/stories-browser.integration.js",
    "test:private-route": "node --test dist/test/private-route-evidence.integration.js",
    "test:storyteller": "node --test --test-concurrency=1 dist/test/storyteller-imported-start.integration.js dist/test/storyteller-journey-schedule.integration.js dist/test/storyteller-preparation-hold.integration.js dist/test/storyteller-activity-admission.integration.js dist/test/storyteller-accepted-plan.integration.js dist/test/storyteller-activity-settlement.integration.js dist/test/storyteller-publication-context.integration.js dist/test/storyteller-provider-budget.integration.js dist/test/storyteller-memory-exploration.integration.js dist/test/storyteller-provider-recovery.integration.js dist/test/storyteller-worker-replay.integration.js dist/test/storyteller-browser-creation.integration.js",
    "test:storyteller:profiled": "node --test dist/test/storyteller.integration.js",
    "test:story03-t06:worker-replay": "node --test dist/test/storyteller-worker-replay.integration.js",
    "test:story03-t06:publication-context": "node --test dist/test/storyteller-publication-context.integration.js",
    "test:story03-t06:activity-settlement": "node --test dist/test/storyteller-activity-settlement.integration.js",
    "test:story03-t09:causal": "node --test --test-concurrency=1 dist/test/story03-causal-multiprocess.integration.js",
    "test:turn03-fixture": "node --test dist/test/turn03-distributed-poc-fixture.integration.js",
    "test:start-package": "node --test dist/test/start-package.integration.js",
    "test:admin-session": "node --test dist/test/admin-session.integration.js",
    "test:admin-policy": "node --test dist/test/admin-policy.integration.js",
    "test:admin-player-reads": "node --test dist/test/admin-player-reads.integration.js",
    "test:admin-diagnostics": "node --test dist/test/admin-diagnostics.integration.js",
    "test:admin-usage": "node --test dist/test/admin-usage.integration.js",
    "test:admin-audit": "node --test dist/test/admin-audit.integration.js",
    "test:admin-cases": "node --test dist/test/admin-cases.integration.js",
    "test:admin-control-ssr": "node --test dist/test/admin-control-ssr.integration.js",
    "test:turn03-proof": "node --test dist/test/turn03-distributed-poc-proof.test.js",
    "test:legacy-engine:pure": "node scripts/run-legacy-engine-tests.mjs --mode=pure",
    "test:legacy-engine:disposable": "node scripts/run-legacy-engine-tests.mjs --mode=disposable",
    "test:legacy-engine:integration": "node scripts/run-legacy-engine-tests.mjs --mode=integration",
    "test:legacy-engine:live": "node scripts/run-legacy-engine-tests.mjs --mode=live"
  },
  "dependencies": {
    "@offscreen/admin": "workspace:*",
    "@offscreen/admin-interface": "workspace:*",
    "@offscreen/api": "workspace:*",
    "@offscreen/api-lab": "workspace:*",
    "@offscreen/content-packages": "workspace:*",
    "@offscreen/game-authority-protocol": "workspace:*",
    "@offscreen/db": "workspace:*",
    "@offscreen/identity-persistence": "workspace:*",
    "@offscreen/documents": "workspace:*",
    "@offscreen/game": "workspace:*",
    "@offscreen/lab-support": "workspace:*",
    "@offscreen/story-engine": "workspace:*",
    "@offscreen/story-persistence": "workspace:*",
    "@offscreen/storyteller": "workspace:*",
    "@offscreen/web": "workspace:*",
    "@offscreen/worker": "workspace:*",
    "@temporalio/client": "1.24.0",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.2",
    "playwright": "1.63.0",
    "zod": "4.6.5",
    "@offscreen/story-interface": "workspace:*"
  },
  "devDependencies": {
    "@offscreen/lab-interface": "workspace:*",
    "@offscreen/cache-port": "workspace:*",
